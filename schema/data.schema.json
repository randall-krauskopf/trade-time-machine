{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trade Time Machine snapshot (docs/data.json)",
  "description": "Written by generate.py; read by every page in docs/. Bump schema_version for breaking changes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "first_trade_date", "discord_imported", "leagues"],
  "properties": {
    "schema_version": {"const": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "first_trade_date": {"$ref": "#/$defs/isoDate"},
    "discord_imported": {"type": "boolean"},
    "leagues": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/league"}}
  },
  "$defs": {
    "isoDate": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "week": {"type": "integer", "minimum": 1},
    "weekKey": {"type": "string", "pattern": "^[1-9]\\d*$"},
    "points": {"type": "number"},
    "nullablePoints": {"type": ["number", "null"]},
    "result": {"enum": ["W", "L", "T"]},
    "playerRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {"id": {"type": "integer"}, "name": {"type": "string"}}
    },
    "league": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key", "label", "league", "season", "generated_at", "completed_weeks", "first_trade_date",
        "trades", "alternate_standings", "weekly_roster_moves", "source", "discord_imported", "receipts_enabled"
      ],
      "properties": {
        "key": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "label": {"type": "string", "minLength": 1},
        "league": {"type": "string"},
        "season": {"type": "integer"},
        "generated_at": {"type": "string", "format": "date-time"},
        "completed_weeks": {"type": "array", "items": {"$ref": "#/$defs/week"}},
        "first_trade_date": {"$ref": "#/$defs/isoDate"},
        "trades": {"type": "array", "items": {"$ref": "#/$defs/trade"}},
        "teams": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["team_id", "team"],
            "properties": {
              "team_id": {"type": "integer"},
              "team": {"type": "string"}
            }
          }
        },
        "alternate_standings": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/alternateStandings"}]},
        "weekly_roster_moves": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/weeklyRosterMoves"}]},
        "source": {"enum": ["activity", "reconstructed"]},
        "discord_imported": {"type": "boolean"},
        "receipts_enabled": {"type": "boolean"}
      }
    },
    "trade": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "traded_at", "transaction_week", "weeks", "trade_week", "sides", "receipts"],
      "properties": {
        "id": {"type": "string", "pattern": "^\\d+-\\d+-\\d+$"},
        "traded_at": {"type": "string", "format": "date-time"},
        "transaction_week": {"$ref": "#/$defs/week"},
        "weeks": {"type": "array", "items": {"$ref": "#/$defs/week"}},
        "trade_week": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/week"}]},
        "sides": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/tradeSide"}},
        "receipts": {"type": "array", "items": {"$ref": "#/$defs/receipt"}}
      }
    },
    "tradeSide": {
      "type": "object",
      "additionalProperties": false,
      "required": ["team_id", "team", "sent", "received", "weekly_points", "total_points"],
      "properties": {
        "team_id": {"type": "integer"},
        "team": {"type": "string"},
        "sent": {"type": "array", "items": {"$ref": "#/$defs/playerRef"}},
        "received": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "weeks"],
            "properties": {
              "id": {"type": "integer"},
              "name": {"type": "string"},
              "weeks": {
                "type": "object",
                "propertyNames": {"$ref": "#/$defs/weekKey"},
                "additionalProperties": {"$ref": "#/$defs/nullablePoints"}
              }
            }
          }
        },
        "weekly_points": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/weekKey"},
          "additionalProperties": {"$ref": "#/$defs/nullablePoints"}
        },
        "total_points": {"$ref": "#/$defs/nullablePoints"}
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "author", "content", "sent_at", "url"],
      "properties": {
        "channel": {"type": "string"},
        "author": {"type": "string"},
        "content": {"type": "string", "maxLength": 600},
        "sent_at": {"type": "string", "format": "date-time"},
        "url": {"type": "string", "pattern": "^https://discord\\.com/channels/"}
      }
    },
    "alternateStandings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["weeks", "teams", "source"],
      "properties": {
        "source": {"const": "weekly_box_scores"},
        "weeks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["week", "rewound_players"],
            "properties": {
              "week": {"$ref": "#/$defs/week"},
              "rewound_players": {"type": "integer", "minimum": 0},
              "matchups": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["home_team_id", "away_team_id", "home_score", "away_score"],
                  "properties": {
                    "home_team_id": {"type": "integer"},
                    "away_team_id": {"type": "integer"},
                    "home_score": {"type": "number"},
                    "away_score": {"type": "number"}
                  }
                }
              },
              "lineups": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["team_id", "team", "actual_points", "optimal_points", "points_left", "top_bench"],
                  "properties": {
                    "team_id": {"type": "integer"},
                    "team": {"type": "string", "minLength": 1},
                    "actual_points": {"type": "number"},
                    "optimal_points": {"type": "number"},
                    "points_left": {"type": "number", "minimum": 0},
                    "top_bench": {
                      "oneOf": [
                        {"type": "null"},
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["id", "name", "points"],
                          "properties": {"id": {"type": "integer"}, "name": {"type": "string"}, "points": {"type": "number"}}
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "teams": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "team_id", "team", "actual_wins", "actual_losses", "actual_ties", "actual_points",
              "alternate_wins", "alternate_losses", "alternate_ties", "alternate_points",
              "optimal_actual_wins", "optimal_actual_losses", "optimal_actual_ties", "optimal_actual_points",
              "wins_change"
            ],
            "properties": {
              "team_id": {"type": "integer"},
              "team": {"type": "string"},
              "actual_wins": {"type": "integer", "minimum": 0},
              "actual_losses": {"type": "integer", "minimum": 0},
              "actual_ties": {"type": "integer", "minimum": 0},
              "actual_points": {"$ref": "#/$defs/points"},
              "alternate_wins": {"type": "integer", "minimum": 0},
              "alternate_losses": {"type": "integer", "minimum": 0},
              "alternate_ties": {"type": "integer", "minimum": 0},
              "alternate_points": {"$ref": "#/$defs/points"},
              "optimal_actual_wins": {"type": "integer", "minimum": 0},
              "optimal_actual_losses": {"type": "integer", "minimum": 0},
              "optimal_actual_ties": {"type": "integer", "minimum": 0},
              "optimal_actual_points": {"$ref": "#/$defs/points"},
              "wins_change": {"type": "number"}
            }
          }
        }
      }
    },
    "weeklyRosterMoves": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rows", "source"],
      "properties": {
        "source": {"const": "weekly_trade_bundles"},
        "rows": {"type": "array", "items": {"$ref": "#/$defs/weeklyRow"}},
        "omitted": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["week", "team_id"],
            "properties": {"week": {"$ref": "#/$defs/week"}, "team_id": {"type": "integer"}}
          }
        }
      }
    },
    "weeklyRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "week", "team_id", "team", "trade_count", "trade_ids", "received", "sent", "actual_score",
        "alternate_score", "net_points", "opponent", "opponent_score", "opponent_alternate_score",
        "result", "alternate_result", "flipped", "replacements", "snapshot_status"
      ],
      "properties": {
        "week": {"$ref": "#/$defs/week"},
        "team_id": {"type": "integer"},
        "team": {"type": "string"},
        "trade_count": {"type": "integer", "minimum": 1},
        "trade_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "received": {"type": "array", "items": {"$ref": "#/$defs/playerRef"}},
        "sent": {"type": "array", "items": {"$ref": "#/$defs/playerRef"}},
        "actual_score": {"$ref": "#/$defs/points"},
        "alternate_score": {"$ref": "#/$defs/points"},
        "net_points": {"$ref": "#/$defs/points"},
        "opponent": {"type": ["string", "null"]},
        "opponent_score": {"$ref": "#/$defs/points"},
        "opponent_alternate_score": {"$ref": "#/$defs/points"},
        "result": {"$ref": "#/$defs/result"},
        "alternate_result": {"$ref": "#/$defs/result"},
        "flipped": {"type": "boolean"},
        "final_lineup": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "slot", "points"],
            "properties": {
              "id": {"type": "integer"},
              "name": {"type": "string"},
              "slot": {"type": "string"},
              "points": {"$ref": "#/$defs/points"}
            }
          }
        },
        "replacements": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["slot", "name", "points", "replaced"],
            "properties": {
              "slot": {"type": "string"},
              "name": {"type": ["string", "null"]},
              "points": {"$ref": "#/$defs/points"},
              "replaced": {"type": ["string", "null"]}
            }
          }
        },
        "snapshot_status": {"const": "reconstructed_from_trades_and_weekly_box_score"}
      }
    }
  }
}
